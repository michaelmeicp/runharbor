{
  "name": "@michaelmeicp/runharbor",
  "version": "0.1.0-alpha.1",
  "description": "A local workbench for scheduled agents. Results in one place. Only exceptions in your inbox.",
  "type": "module",
  "bin": {
    "runharbor": "src/cli.js"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelmeicp/runharbor.git"
  },
  "files": [
    "src",
    "web",
    "packages",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node src/cli.js start",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test && npm audit --omit=dev --audit-level=high",
    "test:browser": "node scripts/browser-smoke.js"
  },
  "dependencies": {
    "croner": "10.0.1"
  },
  "keywords": [
    "agents",
    "local-first",
    "scheduler",
    "ai-agents",
    "agent-orchestration",
    "workbench"
  ],
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9"
  }
}
